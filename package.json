{
  "name": "tokokino",
  "version": "2.2.0",
  "type": "module",
  "private": false,
  "author": {
    "name": "Shiva Bhattacharjee"
  },
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "next dev",
    "build": "opennextjs-cloudflare build",
    "build:next": "next build",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "lint:strict": "eslint --max-warnings=0",
    "lint:fix:strict": "eslint --fix --max-warnings=0",
    "format": "oxfmt \"**/*.{ts,tsx}\"",
    "format:check": "oxfmt --check \"**/*.{ts,tsx}\"",
    "test": "vitest run tests",
    "test:watch": "vitest tests",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "build:thumbs": "node scripts/build-overlay-thumbs.mjs",
    "build:backgrounds": "node --env-file-if-exists=.env.local scripts/build-background-thumbs.mjs",
    "build:shapes": "node --env-file-if-exists=.env.local scripts/build-shapes.mjs"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "oxfmt",
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1037.0",
    "@cloudflare/puppeteer": "^1.3.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@opennextjs/cloudflare": "^1.20.2",
    "@remixicon/react": "^4.9.0",
    "@smithy/fetch-http-handler": "^5.6.13",
    "@xyflow/react": "^12.10.2",
    "better-auth": "^1.6.11",
    "class-variance-authority": "^0.7.1",
    "cloudflare": "^7.0.0",
    "clsx": "^2.1.1",
    "color": "^5.0.3",
    "date-fns": "^4.2.1",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-react": "^8.6.0",
    "fuse.js": "^7.5.0",
    "gifenc": "^1.0.3",
    "html-to-image": "^1.11.13",
    "import-in-the-middle": "^1.15.0",
    "lodash": "^4.18.1",
    "lucide-react": "^1.9.0",
    "mediabunny": "^1.50.7",
    "motion": "^12.38.0",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.9.17",
    "ogl": "^1.0.11",
    "plyr": "^3.8.4",
    "posthog-js": "^1.407.3",
    "posthog-node": "^5.46.1",
    "radix-ui": "^1.4.3",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-image-crop": "^11.0.10",
    "react-infinite-scroll-component": "^7.2.0",
    "require-in-the-middle": "^7.5.2",
    "shadcn": "^4.4.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "unique-names-generator": "^4.7.1",
    "vaul": "^1.1.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260810.1",
    "@eslint/eslintrc": "^3",
    "@faker-js/faker": "^10.5.0",
    "@tailwindcss/postcss": "^4.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/color": "^4.2.1",
    "@types/lodash": "^4.17.25",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.12",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.0.5",
    "oxfmt": "^0.60.0",
    "postcss": "^8",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "sharp",
      "better-sqlite3"
    ]
  }
}
